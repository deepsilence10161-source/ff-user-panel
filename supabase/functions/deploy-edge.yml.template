# ================================================================
# deploy-edge.yml — Supabase Edge Functions ko source ke saath sync rakhta hai
# ----------------------------------------------------------------
# KYA: supabase/functions/** me change push hote hi (ya manual dispatch)
#      imgbb-upload (aur baaki functions) project par deploy ho jaate hain.
#
# KYU: 2026-09-15 tak yeh deploy sirf MANUAL tha, isliye client-side fix
#      (core/imgbb.js v33) ship hone ke baad bhi production me purana
#      function (v1) chalta raha jo har upload ko 401 "Invalid session"
#      deta tha — user ko "Screenshot server pe upload nahi hua" /
#      "Banner upload failed" dikhta raha. Code aur deployed function
#      ke beher ka gap hi bug tha; yeh workflow woh gap khud band karta hai.
#
# SETUP (ek baar, repo settings me):
#   Settings → Secrets and variables → Actions → New repository secret:
#     SUPABASE_ACCESS_TOKEN  = supabase.ai → account → access tokens
#   Optional:
#     IMGBB_KEY              = ImgBB API key (function secret bhi set karega)
#   Optional variable:
#     SUPABASE_PROJECT_REF   = project ref (default: hddhkculuyrfoevmlwy)
#
# Note: gateway JWT verification `--no-verify-jwt` se band rakha gaya hai
#       taki CI me interactive prompt na aaye; auth ki zimmedari function
#       khud leta hai (Firebase ID token / Supabase JWT cryptographically
#       verify karke — see supabase/functions/imgbb-upload/index.ts).
# ================================================================
name: deploy-edge-functions

on:
  workflow_dispatch:
  push:
    branches: [main]
    paths:
      - 'supabase/functions/**'

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Setup Supabase CLI
        uses: supabase/setup-cli@v1
        with:
          version: latest

      - name: Set function secrets (if provided)
        if: ${{ secrets.IMGBB_KEY != '' }}
        env:
          SUPABASE_ACCESS_TOKEN: ${{ secrets.SUPABASE_ACCESS_TOKEN }}
          PROJECT_REF: ${{ vars.SUPABASE_PROJECT_REF || 'hddhkculuyrfoevmlwy' }}
          IMGBB_KEY: ${{ secrets.IMGBB_KEY }}
        run: |
          supabase secrets set IMGBB_KEY="$IMGBB_KEY" FIREBASE_PROJECT_ID=fft-app-1e283 --project-ref "$PROJECT_REF"

      - name: Deploy imgbb-upload
        env:
          SUPABASE_ACCESS_TOKEN: ${{ secrets.SUPABASE_ACCESS_TOKEN }}
          PROJECT_REF: ${{ vars.SUPABASE_PROJECT_REF || 'hddhkculuyrfoevmlwy' }}
        run: supabase functions deploy imgbb-upload --project-ref "$PROJECT_REF" --no-verify-jwt

      - name: Deploy payment functions
        env:
          SUPABASE_ACCESS_TOKEN: ${{ secrets.SUPABASE_ACCESS_TOKEN }}
          PROJECT_REF: ${{ vars.SUPABASE_PROJECT_REF || 'hddhkculuyrfoevmlwy' }}
        run: |
          supabase functions deploy paytm-create-order --project-ref "$PROJECT_REF" --no-verify-jwt
          supabase functions deploy paytm-callback --project-ref "$PROJECT_REF" --no-verify-jwt
