name: Deploy image upload function

on:
  workflow_dispatch:
  push:
    branches: [main]
    paths:
      - '.github/workflows/deploy-imgbb-upload.yml'
      - 'supabase/config.toml'
      - 'supabase/functions/imgbb-upload/**'

permissions:
  contents: read

concurrency:
  group: deploy-imgbb-upload-production
  cancel-in-progress: false

jobs:
  deploy:
    runs-on: ubuntu-latest
    env:
      PROJECT_REF: ${{ vars.SUPABASE_PROJECT_REF || 'hddhkculuyrfoevxmlwy' }}
      SUPABASE_ACCESS_TOKEN: ${{ secrets.SUPABASE_ACCESS_TOKEN }}
      IMGBB_KEY: ${{ secrets.IMGBB_KEY }}

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Check deployment credentials
        shell: bash
        run: |
          if [ -z "$SUPABASE_ACCESS_TOKEN" ]; then
            echo "::error::Add SUPABASE_ACCESS_TOKEN in repository Settings → Secrets and variables → Actions."
            exit 1
          fi

      - name: Setup Supabase CLI
        uses: supabase/setup-cli@v1
        with:
          version: latest

      - name: Sync optional image-host secret
        if: ${{ env.IMGBB_KEY != '' }}
        run: |
          supabase secrets set \
            IMGBB_KEY="$IMGBB_KEY" \
            FIREBASE_PROJECT_ID=fft-app-1e283 \
            --project-ref "$PROJECT_REF"

      - name: Deploy imgbb-upload with gateway JWT check disabled
        run: |
          # Auth is NOT disabled: index.ts verifies the Firebase ID token's
          # RS256 signature, issuer, audience, expiry and uid itself.
          supabase functions deploy imgbb-upload \
            --project-ref "$PROJECT_REF" \
            --no-verify-jwt

      - name: Verify request reaches function code
        shell: bash
        run: |
          URL="https://${PROJECT_REF}.supabase.co/functions/v1/imgbb-upload"
          BODY_FILE="$(mktemp)"
          STATUS="$(curl --silent --show-error \
            --output "$BODY_FILE" --write-out '%{http_code}' \
            --request POST "$URL" \
            --header 'Content-Type: text/plain;charset=UTF-8' \
            --data '{"image":"QUJD","name":"deployment-health-check"}')"
          BODY="$(cat "$BODY_FILE")"
          echo "HTTP $STATUS: $BODY"
          # No Firebase token should be rejected BY OUR FUNCTION. Seeing the
          # gateway's UNAUTHORIZED_NO_AUTH_HEADER means verify_jwt is still on.
          if echo "$BODY" | grep -q 'UNAUTHORIZED_NO_AUTH_HEADER'; then
            echo "::error::Gateway JWT verification is still enabled."
            exit 1
          fi
          if [ "$STATUS" != '401' ] || ! echo "$BODY" | grep -q 'Login required'; then
            echo "::error::Unexpected image function health-check response."
            exit 1
          fi
