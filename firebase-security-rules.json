{
  "rules": {
    "appSettings": {
      ".read":  true,
      ".write": false
    },
    "matches": {
      ".read":  "auth != null",
      ".write": false
    },
    "notifications": {
      ".read":  "auth != null",
      ".write": "auth != null"
    },
    "support": {
      "$ticketId": {
        "messages": {
          "$msgId": {
            ".read":  "auth != null",
            ".write": "auth != null"
          }
        }
      }
    },
    "deviceJoins": {
      "$deviceId": {
        "$matchId": {
          ".read":  "auth != null",
          ".write": "auth != null"
        }
      }
    },
    "joinRequests": {
      ".read":  "auth != null",
      ".write": "auth != null"
    },
    "users": {
      "$uid": {
        ".read":  "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "clans": {
      ".read":  "auth != null",
      ".write": "auth != null"
    },
    "polls": {
      ".read":  "auth != null",
      ".write": false
    },
    "$other": {
      ".read":  false,
      ".write": false
    }
  }
}
