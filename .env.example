# =============================================================
# MINI eSPORTS — Environment Variables Template
# Bug 81 Fix: Secrets were hardcoded in source files.
#
# HOW TO USE:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your real values in .env
# 3. NEVER commit .env to git (it's in .gitignore)
# 4. For Cloudflare Pages: add these in dashboard → Settings → Environment Variables
# =============================================================

# ── FIREBASE ──
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_RTDB_URL=https://your-project-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_APP_ID=1:your_app_id
FIREBASE_MESSAGING_ID=your_messaging_id

# ── SUPABASE ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── IMGBB ──
IMGBB_API_KEY=your_imgbb_api_key_here

# ── ADMOB ──
ADMOB_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~xxxxxxxxxx
ADMOB_REWARDED_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
ADMOB_INTERSTITIAL_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
ADMOB_BANNER_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx

# ── ONESIGNAL ──
ONESIGNAL_APP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── UPI ──
UPI_ID=yourupi@bank

# ── APP ──
APP_NAME=MiniESports
APP_ENV=production
